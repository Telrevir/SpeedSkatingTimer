.page { padding: 28rpx; }
.storage-warning { margin-bottom: 20rpx; padding: 20rpx 24rpx; border-radius: 18rpx; background: #fff7e6; color: #9a6700; font-size: 22rpx; line-height: 1.55; }
.toolbar { display: flex; flex-direction: column; gap: 16rpx; padding: 24rpx; border-radius: 24rpx; background: #fff; }
.form-title { color: #172033; font-size: 28rpx; font-weight: 700; }
.form-input { box-sizing: border-box; width: 100%; height: 78rpx; padding: 0 22rpx; border: 1rpx solid #d0d5dd; border-radius: 14rpx; color: #172033; font-size: 26rpx; }
.form-actions { display: flex; gap: 16rpx; }
.form-actions button { flex: 1; margin: 0; }
.group-manage { margin: 0; background: #f2f4f7 !important; color: #344054 !important; }
.primary { background: #2563eb !important; color: #fff !important; }
.secondary { background: #eef4ff !important; color: #2457c5 !important; }
.empty { margin-top: 24rpx; padding: 80rpx 32rpx; border-radius: 24rpx; background: #fff; color: #667085; text-align: center; }
.athlete-list { overflow: hidden; margin-top: 24rpx; border-radius: 24rpx; background: #fff; }
.athlete-row { display: grid; grid-template-columns: minmax(170rpx, 1fr) 70rpx 140rpx 180rpx; align-items: center; min-height: 112rpx; padding: 0 20rpx; border-top: 1rpx solid #edf0f4; color: #475467; font-size: 24rpx; }
.athlete-name, .athlete-epc { display: block; }
.athlete-name { overflow: hidden; color: #172033; font-size: 28rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.athlete-epc { margin-top: 5rpx; color: #98a2b3; font-size: 20rpx; }
.delete { margin: 0; padding: 0 14rpx; background: #fff1f0 !important; color: #d92d20 !important; font-size: 22rpx; }
.row-actions { display: flex; justify-content: flex-end; gap: 8rpx; }
.row-actions button { margin: 0; padding: 0 12rpx; font-size: 21rpx; }
.edit { background: #eef4ff !important; color: #2457c5 !important; }
.restore { background: #ecfdf3 !important; color: #067647 !important; }
.archive-toggle { margin: 22rpx 0 0; background: #f2f4f7 !important; color: #475467 !important; }
.archived-list { opacity: .92; }
.archived-row { display: flex; align-items: center; justify-content: space-between; min-height: 100rpx; padding: 0 20rpx; border-top: 1rpx solid #edf0f4; }
.empty-inline { padding: 40rpx; color: #98a2b3; text-align: center; }
.group-list { margin-top: 24rpx; padding: 22rpx; border-radius: 24rpx; background: #fff; }
.group-list-title { margin-bottom: 12rpx; color: #667085; font-size: 22rpx; }
.group-chip { display: inline-block; margin: 6rpx; padding: 10rpx 16rpx; border-radius: 999rpx; background: #eef4ff; color: #2457c5; font-size: 22rpx; }
.modal-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(16, 24, 40, .45); }
.group-modal { box-sizing: border-box; width: 100%; padding: 28rpx; border-radius: 24rpx; background: #fff; }
.modal-title { display: block; margin-bottom: 20rpx; font-size: 32rpx; font-weight: 700; }
.group-candidates { max-height: 520rpx; margin-top: 16rpx; border: 1rpx solid #eaecf0; border-radius: 14rpx; }
.candidate-row { display: flex; align-items: center; gap: 14rpx; min-height: 76rpx; padding: 0 16rpx; border-bottom: 1rpx solid #f2f4f7; }
.modal-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 20rpx; }
.modal-actions button { margin: 0; }
.danger { background: #fff1f0 !important; color: #d92d20 !important; }
