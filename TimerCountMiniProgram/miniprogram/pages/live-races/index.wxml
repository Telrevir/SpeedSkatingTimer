<view class="page">
  <view class="page-head">
    <view>
      <text class="page-title">当前比赛</text>
      <text class="page-subtitle">列表自动刷新，展开后查看实时成绩</text>
    </view>
    <navigator class="history-link" url="/pages/scores/index" open-type="switchTab">历史记录</navigator>
  </view>

  <view wx:if="{{errorMessage}}" class="status error-status">
    <text>{{errorMessage}}</text>
    <button size="mini" disabled="{{loading}}" bindtap="retry">重试</button>
  </view>
  <view wx:if="{{loading && !races.length}}" class="status">正在查询当前比赛…</view>

  <view wx:if="{{races.length}}" class="race-list">
    <view class="race-card" wx:for="{{races}}" wx:for-item="race" wx:key="id">
      <view class="race-head" data-id="{{race.id}}" bindtap="toggleRace" hover-class="head-active">
        <view class="race-title">
          <text class="arrow">{{race.expanded ? '⌄' : '›'}}</text>
          <view><text class="race-number">比赛 #{{race.id}}</text><text class="started-at">{{race.startedAt}}</text></view>
        </view>
        <view class="summary">
          <view><text class="summary-label">总用时</text><text class="summary-value">{{race.elapsedTime}}</text></view>
          <view><text class="summary-label">圈数</text><text class="summary-value">{{race.maximumLap}}</text></view>
          <view><text class="summary-label">领滑</text><text class="summary-value leader">{{race.leaderName}}</text></view>
        </view>
      </view>

      <view wx:if="{{race.expanded}}" class="score-table">
        <view class="score-row score-header"><text>运动员</text><text>圈数</text><text>单圈</text><text>总用时</text><text>排名</text></view>
        <view wx:for="{{race.rows}}" wx:for-item="score" wx:key="key" class="score-row">
          <text class="score-name">{{score.name}}</text><text>{{score.lap}}</text><text>{{score.lapTime}}</text><text>{{score.totalTime}}</text><text class="rank">{{score.rank}}</text>
        </view>
        <view wx:if="{{!race.rows.length}}" class="empty-inline">等待首条成绩</view>
      </view>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty"><text class="empty-title">暂无进行中的比赛</text><text>开始比赛后会自动出现在这里。</text></view>
</view>
