<view class="page">
  <view class="storage-warning {{backendAvailable ? 'storage-online' : 'storage-offline'}}">
    {{backendAvailable ? '名单已与服务器连接，修改将在服务器确认后生效。' : (backendMessage || '正在连接服务器，已缓存名单仍可查看和参赛。')}}
  </view>

  <view class="group-panel">
    <text class="group-panel-title">运动员分组</text>
    <button class="primary group-create" size="mini" disabled="{{!managementEnabled || !backendAvailable || busy}}" bindtap="openNewGroup">添加分组</button>
    <view class="group-choice-list">
      <view class="group-choice-row {{selectedRaceGroupId === '' ? 'group-choice-selected' : ''}}" data-id="" bindtap="applyRaceGroup">
        <view>
          <text class="group-action-name">全部运动员<text wx:if="{{selectedRaceGroupId === ''}}" class="group-choice-mark">（已选择）</text></text>
        </view>
        <view class="group-row-actions">
          <button class="edit" size="mini" disabled>修改</button>
          <button class="delete" size="mini" disabled>删除</button>
        </view>
      </view>
      <view wx:for="{{groups}}" wx:key="id" class="group-choice-row {{selectedRaceGroupId === item.id ? 'group-choice-selected' : ''}}" data-id="{{item.id}}" bindtap="applyRaceGroup">
        <view>
          <text class="group-action-name">{{item.name}}<text wx:if="{{selectedRaceGroupId === item.id}}" class="group-choice-mark">（已选择）</text></text>
          <text class="group-action-meta">{{item.count}} 名运动员</text>
        </view>
        <view class="group-row-actions">
          <button class="edit" size="mini" data-id="{{item.id}}" disabled="{{!managementEnabled || !backendAvailable || busy}}" catchtap="editGroup">修改</button>
          <button class="delete" size="mini" data-id="{{item.id}}" disabled="{{!managementEnabled || !backendAvailable || busy}}" catchtap="deleteGroupFromList">删除</button>
        </view>
      </view>
    </view>
  </view>

  <view class="toolbar">
    <text class="form-title">新建运动员</text>
    <view class="form-actions">
      <button class="primary" size="mini" disabled="{{!managementEnabled || !backendAvailable || busy}}" bindtap="openCreateAthlete">添加运动员</button>
    </view>
  </view>

  <input class="form-input athlete-search" value="{{athleteSearch}}" placeholder="搜索运动员" bindinput="updateAthleteSearch" />

  <view wx:if="{{groups.length}}" class="group-list legacy-group-options">
    <view class="group-list-title">已有分组</view>
    <view class="group-chip" wx:for="{{groups}}" wx:key="id">{{item.name}}（{{item.count}}人）</view>
  </view>

  <view wx:if="{{athletes.length}}" class="athlete-list">
    <view class="athlete-row" wx:for="{{athletes}}" wx:key="id">
      <view>
        <text class="athlete-name">{{item.name}}（{{item.epc}}）</text>
      </view>
      <view class="row-actions">
        <button class="edit" size="mini" data-id="{{item.id}}" disabled="{{!managementEnabled || !backendAvailable || busy}}" bindtap="editAthlete">编辑</button>
        <button class="delete" size="mini" data-id="{{item.id}}" disabled="{{!managementEnabled || !backendAvailable || busy}}" bindtap="archiveAthlete">删除</button>
      </view>
    </view>
  </view>
  <view wx:else class="empty">尚未添加运动员。</view>

  <view wx:if="{{showArchived}}" class="athlete-list archived-list">
    <block wx:if="{{archivedAthletes.length}}">
      <view class="archived-row" wx:for="{{archivedAthletes}}" wx:key="id">
        <view>
          <text class="athlete-name">{{item.name}}（{{item.epc}}）</text>
        </view>
        <view class="row-actions">
          <button class="edit" size="mini" data-id="{{item.id}}" disabled="{{!managementEnabled || !backendAvailable || busy}}" bindtap="editAthlete">编辑</button>
          <button class="restore" size="mini" data-id="{{item.id}}" disabled="{{!managementEnabled || !backendAvailable || busy}}" bindtap="restoreAthlete">恢复</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty-inline">暂无归档运动员</view>
  </view>

  <view wx:if="{{groupModalVisible}}" class="modal-mask">
    <view class="group-modal">
      <text class="modal-title">{{editingGroupId ? '编辑分组' : '新建分组'}}</text>
      <input class="form-input" value="{{groupFormName}}" placeholder="分组名称" bindinput="updateGroupName" disabled="{{busy || !backendAvailable}}" />
      <input class="form-input" value="{{groupSearch}}" placeholder="搜索姓名、EPC或ID" bindinput="updateGroupSearch" disabled="{{busy || !backendAvailable}}" />
      <scroll-view scroll-y class="group-candidates">
        <view class="candidate-grid">
          <view wx:for="{{groupCandidates}}" wx:key="id" class="candidate-card {{item.selected ? 'candidate-card-selected' : ''}}" data-id="{{item.id}}" bindtap="toggleGroupMember">
            <text class="candidate-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="modal-actions">
        <button size="mini" disabled="{{busy}}" bindtap="closeGroupEditor">取消</button>
        <button size="mini" class="primary" loading="{{busy}}" disabled="{{busy || !backendAvailable}}" bindtap="saveGroup">保存</button>
      </view>
    </view>
  </view>

  <view wx:if="{{athleteCreateVisible}}" class="modal-mask">
    <view class="athlete-editor-modal">
      <text class="modal-title">添加运动员</text>
      <input class="form-input" value="{{formName}}" maxlength="32" placeholder="运动员姓名" bindinput="updateName" disabled="{{busy || !backendAvailable}}" />
      <input class="form-input" value="{{formEpc}}" maxlength="8" placeholder="8 位 EPC，例如 A1B2C3D4" bindinput="updateEpc" disabled="{{busy || !backendAvailable}}" />
      <view class="modal-actions">
        <button size="mini" disabled="{{busy}}" bindtap="closeCreateAthlete">取消</button>
        <button size="mini" class="primary" loading="{{busy}}" disabled="{{busy || !backendAvailable}}" bindtap="saveAthlete">保存</button>
      </view>
    </view>
  </view>

  <view wx:if="{{athleteEditorVisible}}" class="modal-mask">
    <view class="athlete-editor-modal">
      <text class="modal-title">编辑运动员 #{{editingId}}</text>
      <input class="form-input" value="{{editFormName}}" maxlength="32" placeholder="运动员姓名" bindinput="updateEditingName" disabled="{{busy || !backendAvailable}}" />
      <input class="form-input" value="{{editFormEpc}}" maxlength="8" placeholder="8 位 EPC，例如 A1B2C3D4" bindinput="updateEditingEpc" disabled="{{busy || !backendAvailable}}" />
      <view class="modal-actions">
        <button size="mini" disabled="{{busy}}" bindtap="closeAthleteEditor">取消</button>
        <button size="mini" class="primary" loading="{{busy}}" disabled="{{busy || !backendAvailable}}" bindtap="saveEditedAthlete">保存</button>
      </view>
    </view>
  </view>
</view>
