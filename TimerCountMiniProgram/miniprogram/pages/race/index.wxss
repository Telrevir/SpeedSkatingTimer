.page {
  padding: 28rpx 28rpx 48rpx;
}

.leader-card,
.ranking-card {
  display: flex;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 51, 0.08);
}


.state-card {
  margin-top: 24rpx;
  padding: 34rpx;
  border-radius: 24rpx;
  color: #ffffff;
}

.state-label,
.state-value {
  display: block;
}

.state-label { font-size: 22rpx; opacity: 0.82; }
.state-value { margin-top: 8rpx; font-size: 40rpx; font-weight: 700; }
.finish-lap { display: block; margin-top: 12rpx; font-size: 24rpx; opacity: .88; }
.state-disconnected { background: #667085; }
.state-idle { background: #475467; }
.state-waiting { background: #d4930d; }
.state-running { background: #16875b; }
.state-finished { background: #d13f4c; }

.group-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 24rpx 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
}
.group-name { display: block; margin-top: 8rpx; color: #667085; font-size: 24rpx; }
.group-button { margin: 0; border-radius: 999rpx; background: #eef4ff; color: #2457c5; }

.leader-card,
.ranking-card {
  flex-direction: column;
  margin-top: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.leader-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 28rpx;
}

.metric {
  padding: 22rpx 12rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
  text-align: center;
}

.metric-label,
.metric-value { display: block; }
.metric-label { color: #667085; font-size: 22rpx; }
.metric-value { margin-top: 8rpx; font-size: 30rpx; font-weight: 700; }

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-hint,
.empty-ranking {
  color: #667085;
  font-size: 24rpx;
}

.top-five { margin-top: 20rpx; }
.top-row { display: grid; grid-template-columns: 52rpx 1fr 90rpx 150rpx; align-items: center; min-height: 74rpx; border-top: 1rpx solid #edf0f4; }
.rank-number { color: #2563eb; font-weight: 700; }
.rank-name { font-weight: 600; }
.finished-badge { margin-left: 10rpx; padding: 3rpx 9rpx; border-radius: 999rpx; background: #ecfdf3; color: #067647; font-size: 18rpx; }
.rank-lap, .rank-time { color: #667085; font-size: 24rpx; text-align: right; }
.lap-correction { color: #f97316; font-weight: 700; }

.empty-ranking {
  padding: 56rpx 0 28rpx;
  text-align: center;
}
.ranking-placeholder { opacity: .45; }

.actions {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20rpx;
  margin-top: 28rpx;
}

.primary-action,
.reset-action {
  border-radius: 999rpx;
  font-weight: 700;
}

.primary-action { background: #2563eb; color: #ffffff; }
.reset-action { background: #ffffff; color: #344054; }
.primary-action[disabled],
.reset-action[disabled] { background: #e4e7ec; color: #98a2b3; }
/* 比赛信息使用放大的字号；连接状态保持为低干扰的小字。 */
.connection-status {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin: 0 4rpx 16rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.4;
}
.state-label { font-size: 28rpx; }
.state-value { font-size: 50rpx; }
.finish-lap { font-size: 30rpx; }

.group-card {
  display: block;
  overflow: hidden;
  padding: 24rpx 30rpx;
  transition: padding .24s ease, min-height .24s ease;
}
.group-full-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-height: 140rpx;
  opacity: 1;
  transform: translateY(0);
  transition: max-height .24s ease, opacity .18s ease, transform .24s ease;
}
.group-content-hidden {
  max-height: 0;
  opacity: 0;
  transform: translateY(-12rpx);
  pointer-events: none;
}
.group-card-compact { min-height: 66rpx; padding: 0 30rpx; }
.group-compact-name {
  display: block;
  max-height: 0;
  opacity: 0;
  color: #667085;
  font-size: 22rpx;
  line-height: 66rpx;
  transition: max-height .24s ease, opacity .18s ease;
}
.group-compact-visible { max-height: 66rpx; opacity: 1; }
.group-name { font-size: 30rpx; }
.group-button { font-size: 30rpx; }

.section-title { font-size: 38rpx; }
.metric-label { font-size: 28rpx; }
.metric-value { font-size: 38rpx; }
.section-hint, .empty-ranking { font-size: 30rpx; }
.top-row { min-height: 92rpx; font-size: 30rpx; }
.rank-number, .rank-name { font-size: 32rpx; }
.rank-lap, .rank-time { font-size: 30rpx; }
.finished-badge { font-size: 22rpx; }

.actions {
  display: grid;
  grid-template-columns: 30vw 30vw;
  column-gap: 15vw;
  justify-content: center;
  align-items: center;
}
/* 临时隐藏连接与分组区域，保留结构以便后续恢复。 */
.connection-status,
.group-card { display: none; }

.state-label { display: block; }
.state-value { margin-top: 8rpx; }
.primary-action,
.reset-action {
  width: 30vw;
  height: 18vw;
  min-height: 18vw;
  margin: 0;
  padding: 0;
  border-radius: 28rpx;
  font-size: 50rpx;
  line-height: 18vw;
  text-align: center;
}
