.page { padding: 28rpx; }
.empty { padding: 80rpx 32rpx; border-radius: 24rpx; background: #fff; color: #667085; text-align: center; }
.title { display: block; margin-bottom: 18rpx; color: #172033; font-size: 34rpx; font-weight: 700; }
.table { overflow: hidden; border-radius: 24rpx; background: #fff; }
.table-row { display: grid; grid-template-columns: 70rpx 1.2fr 70rpx 1.2fr 1.2fr 70rpx; align-items: center; min-height: 82rpx; padding: 0 18rpx; border-top: 1rpx solid #edf0f4; font-size: 23rpx; }
.table-header { border-top: 0; background: #f8fafc; color: #667085; font-weight: 600; }
.rank { color: #2563eb; font-weight: 700; }
.finished { display: inline-block; margin-left: 6rpx; padding: 2rpx 7rpx; border-radius: 999rpx; background: #ecfdf3; color: #067647; font-size: 17rpx; }
.lap-correction { color: #f97316; font-weight: 700; }
