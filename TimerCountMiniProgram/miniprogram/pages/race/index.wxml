<view class="page">
  <text class="connection-status">{{connectionText}}</text>

  <view class="state-card {{raceStateClass}}">
    <text class="state-label">比赛状态</text>
    <text class="state-value">{{raceStateText}}</text>
    <text wx:if="{{finishLapText}}" class="finish-lap">{{finishLapText}}</text>
  </view>


  <view class="group-card {{groupCompact ? 'group-card-compact' : ''}}">
    <view class="group-full-content {{groupCompact ? 'group-content-hidden' : ''}}">
      <view>
        <text class="section-title">当前分组</text>
        <text class="group-name">{{groupName}}</text>
      </view>
      <button class="group-button" size="mini" bindtap="chooseGroup">选择分组</button>
    </view>
    <text class="group-compact-name {{groupCompact ? 'group-compact-visible' : ''}}">{{groupName}}</text>
  </view>

  <view class="leader-card">
    <text class="section-title">当前领滑</text>
    <view class="leader-grid">
      <view class="metric"><text class="metric-label">姓名</text><text class="metric-value">{{leaderName}}</text></view>
      <view class="metric">
        <text class="metric-label">圈数</text>
        <text class="metric-value">{{leaderRawLap}}<text wx:if="{{leaderCorrectionOffset > 0}}" class="lap-correction">+{{leaderCorrectionOffset}}</text></text>
      </view>
      <view class="metric"><text class="metric-label">单圈</text><text class="metric-value">{{leaderLapTime}}</text></view>
    </view>
  </view>

  <view class="ranking-card">
    <view class="section-header"><text class="section-title">实时前五</text></view>
    <view wx:if="{{topFive.length}}" class="top-five">
      <view class="top-row" wx:for="{{topFive}}" wx:key="rank">
        <text class="rank-number">{{item.rank}}</text>
        <text class="rank-name">{{item.name}}<text wx:if="{{item.finished}}" class="finished-badge">完成</text></text>
        <text class="rank-lap">{{item.rawLap}}<text wx:if="{{item.correctionOffset > 0}}" class="lap-correction">+{{item.correctionOffset}}</text> 圈</text>
        <text class="rank-time">{{item.time}}</text>
      </view>
    </view>
    <view wx:else class="top-five">
      <view wx:for="{{rankingPlaceholders}}" wx:key="*this" class="top-row ranking-placeholder"></view>
    </view>
  </view>

  <view class="actions">
    <button class="primary-action" disabled="{{!primaryEnabled}}" bindtap="toggleRace">{{primaryLabel}}</button>
    <button class="reset-action" disabled="{{!resetEnabled}}" bindtap="resetRace">重置</button>
  </view>
</view>
